# Environment variables
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/spotify_analytics

# Optional comma-separated exact localhost/127.0.0.1 origins. Remote origins are rejected.
CORS_ORIGIN=http://localhost:3000

# Optional absolute data directory (default: repository data/)
# SPOTIFY_DATA_DIR=C:/web/Spotify-summary/data
# PostgreSQL utilities for backup/restore (default Windows: PostgreSQL/18/bin; Unix: PATH)
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# DEBUG_SQL=false

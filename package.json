{
    "name": "spotify-analytics",
    "version": "1.0.0",
    "description": "Modern Spotify analytics web application",
    "type": "module",
    "scripts": {
        "dev": "pnpm --parallel --filter spotify-analytics-frontend --filter spotify-analytics-backend run dev",
        "dev:client": "cd frontend && pnpm run dev",
        "dev:server": "cd backend && pnpm run dev",
        "build": "pnpm run build:client && pnpm run build:server",
        "build:client": "cd frontend && pnpm run build",
        "build:server": "cd backend && pnpm run build",
        "start": "cd backend && pnpm start",
        "import-data": "cd backend && pnpm run import-data",
        "setup": "pnpm install && pnpm db:migrate && pnpm run import-data",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "pnpm --dir frontend run lint",
        "check": "pnpm lint && pnpm test:run && pnpm build",
        "preview": "pnpm --dir frontend run preview",
        "db:migrate": "pnpm --dir backend db:migrate",
        "db:backup": "pnpm --dir backend db:backup",
        "test:postgres": "pnpm --dir backend test:postgres",
        "test:e2e": "pnpm --dir backend test:e2e"
    },
    "keywords": [
        "spotify",
        "analytics",
        "react",
        "typescript",
        "postgresql"
    ],
    "author": "Natan TuÄąâ€šodziecki",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "private": true,
    "packageManager": "pnpm@10.34.7",
    "engines": {
        "node": ">=24.0.0 <25",
        "pnpm": ">=10.34.7 <11"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.0",
            "onFail": "download"
        }
    }
}
